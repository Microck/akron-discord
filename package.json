{
  "name": "akron-discord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official Akron Discord bot for server setup, .akr submissions, catalog publishing, and GitHub issue sync.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "register-commands": "tsx src/register-commands.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@octokit/auth-app": "^8.1.2",
    "@octokit/rest": "^22.0.0",
    "better-sqlite3": "^12.4.1",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.9.0",
    "yauzl": "^3.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.2",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "undici": "6.28.0",
    "ws": "8.21.0",
    "vite": "7.3.5",
    "esbuild": "0.28.1"
  }
}
