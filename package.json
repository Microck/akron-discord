{
  "name": "akron-discord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official Akron Discord bot for server setup, .akr submissions, catalog publishing, and GitHub issue sync.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:release": "npm run build && npm run sentry:sourcemaps",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx --import ./src/instrumentation-node.ts --watch src/index.ts",
    "start": "node --import ./dist/src/instrumentation-node.js dist/src/index.js",
    "test": "vitest run --dir tests",
    "register-commands": "tsx src/register-commands.ts",
    "sentry:sourcemaps": "node scripts/upload-sourcemaps.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.0",
    "@sentry/cloudflare": "11.12.0",
    "@sentry/node": "11.12.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.22.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "openai": "^7.54.0",
    "yauzl": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@sentry/cli": "3.8.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.161.0"
  },
  "overrides": {
    "undici": "6.29.1",
    "ws": "8.21.0",
    "vite": "7.3.8",
    "esbuild": "0.28.1"
  }
}
